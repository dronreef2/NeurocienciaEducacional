  "pre_registration": {
    "type": "registered-report",
    "hypotheses": [
      {
        "id": "H1",
        "statement": "Leitura em tela aumenta amplitude do N170 (processamento visual de palavras)",
        "variables": {
          "component": "N170 (~170ms)",
          "region": "Occipito-temporal"
        },
        "predicted_effect": "Amplitude ↑ em tela vs papel",
        "test": "ANOVA mista 2x2"
      },
      {
        "id": "H2",
        "statement": "Leitura em tela reduz amplitude do P300 (atenção)",
        "variables": {
          "component": "P300 (~300ms)",
          "region": "Parietal"
        },
        "predicted_effect": "Amplitude ↓ em tela",
        "test": "ANOVA mista 2x2"
      },
      {
        "id": "H3",
        "statement": "Leitura em tela aumenta amplitude do N400 (integração semântica)",
        "variables": {
          "component": "N400 (~400ms)",
          "region": "Centro-parietal"
        },
        "predicted_effect": "Amplitude ↑ em tela (maior esforço de integração)",
        "test": "ANOVA mista 2x2"
      },
      {
        "id": "H4",
        "statement": "Idade modula o efeito da mídia (interação Idade × Mídia)",
        "variables": {
          "moderator": "Idade"
        },
        "predicted_effect": "Interação significativa",
        "test": "ANCOVA com idade como covariável"
      },
      {
        "id": "H5",
        "statement": "Compreensão é melhor em papel (comportamental)",
        "variables": {
          "outcome": "Compreensão (teste pós-leitura)"
        },
        "predicted_effect": "d = 0.30 a favor do papel",
        "test": "Teste t pareado"
      }
    ],
    "design": {
      "type": "Quase-experimental intra-sujeitos",
      "groups": [
        "Tela (tablet) - 30 crianças",
        "Papel - 30 crianças"
      ],
      "sample_size": 60,
      "n_per_group": 30,
      "duration": "18 meses",
      "blinding": "Análise cega"
    },
    "instruments": [
      "EEG 32 canais (BrainProducts / ActiCHamp)",
      "Tarefa de leitura controlada (paradigma oddball-like)",
      "Teste de compreensão pós-leitura",
      "Eye-tracker (subgrupo N=20)"
    ],
    "erp_components": {
      "N170": {
        "latency_window": "130-210 ms",
        "regions_of_interest": ["PO7", "PO8", "P7", "P8", "O1", "O2"]
      },
      "P200": {
        "latency_window": "200-280 ms",
        "regions_of_interest": ["Pz", "Cz", "Fz"]
      },
      "P300": {
        "latency_window": "280-450 ms",
        "regions_of_interest": ["Pz", "Cz"]
      },
      "N400": {
        "latency_window": "350-550 ms",
        "regions_of_interest": ["Cz", "CPz", "Pz"]
      },
      "P600": {
        "latency_window": "500-800 ms",
        "regions_of_interest": ["Pz", "CPz"]
      }
    },
    "analysis_plan": {
      "preprocessing": [
        "Filtragem 0.1-40 Hz",
        "Filtro notch 60 Hz",
        "ICA para remoção de artefatos oculares",
        "Rejeição de épocas com amplitude > 100 µV",
        "Re-referência ao average"
      ],
      "primary": "ANOVA mista 2 (mídia: tela/papel) × 2 (tarefa: ortográfica/semântica)",
      "secondary": [
        "Cluster-based permutation (1000 permutações)",
        "Time-frequency analysis (wavelet)",
        "Análise de fontes (sLORETA)",
        "Mixed models"
      ],
      "power_analysis": "Simulação Monte Carlo para detectar d=0.5 com power=0.80"
    }
  },
  "funding": "CAPES, CNPq, FAPERN",
  "ethics": "Aprovação CEP/UFRN (número a definir)",
  "data_availability": "Dados anonimizados (BIDS format) serão disponibilizados no OSF"
