<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/xstyl/1.0" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="pt-BR">
  <!-- This file was generated automatically by Zotero via the BibLaTeX → CSL conversion -->
  <!-- Adapted for the Educational Neuroscience Research Program -->
  <info>
    <title>American Psychological Association 7th edition (pt-BR)</title>
    <id>http://www.zotero.org/styles/apa-7-pt-br</id>
    <link href="http://www.zotero.org/styles/apa-7-pt-br" rel="self"/>
    <link href="http://www.zotero.org/styles/apa" rel="template"/>
    <link href="https://apastyle.apa.org" rel="documentation"/>
    <author>
      <name>Adaptado para o Programa de Pesquisa em Neurociência Educacional</name>
      <email>neurociencia@ufrn.br</email>
    </author>
    <category citation-format="author-date"/>
    <category field="psychology"/>
    <category field="education"/>
    <updated>2026-08-12T10:30:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="editortranslator" form="short">ed. e trad.</term>
      <term name="translator" form="short">trad.</term>
      <term name="in">Em</term>
      <term name="and">e</term>
      <term name="retrieved">recuperado em</term>
      <term name="from">em</term>
      <term name="cited">citado</term>
    </terms>
  </locale>
  <macro name="container">
    <choose>
      <if type="chapter paper-conference" match="any">
        <text term="in" text-case="capitalize-first" font-style="italic" prefix=" "/>
        <group delimiter=", ">
          <text macro="container-contributors"/>
          <text macro="container-title"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper periodical post-weblog" match="any">
        <group delimiter=", ">
          <text macro="container-title" font-style="italic"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="container-contributors"/>
          <text macro="container-title"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="author">
    <names variable="author">
      <name delimiter-precedes-last="always" name-as-sort-order="all"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter-precedes-last="always"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="issued">
    <group prefix=" (" suffix=")">
      <choose>
        <if type="article-journal">
          <text variable="volume" font-style="italic"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </if>
        <else>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="title">
    <choose>
      <if type="book thesis report" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="page">
    <group prefix=", ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <group>
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="0">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text macro="author"/>
      <text macro="issued" prefix=" "/>
      <group prefix=". ">
        <text macro="title"/>
      </group>
      <text macro="container" prefix=". "/>
      <text macro="page"/>
      <text variable="DOI" prefix=" https://doi.org/" suffix="."/>
    </layout>
  </bibliography>
</style>
