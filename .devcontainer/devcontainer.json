{
  "name": "Neurociencia Educacional - Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/r:1": {
      "version": "4.4.1"
    },
    "ghcr.io/devcontainers-features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "Ruff.vscode",
        "ms-toolsai.jupyter",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/NeurocienciaEducacional/analise/Python/.venv/bin/python",
        "python.analysis.extraPaths": [
          "analise/Python"
        ],
        "terminal.integrated.cwd": "/workspaces/NeurocienciaEducacional"
      }
    }
  },
  "postCreateCommand": "bash -c 'pip install --break-system-packages -q sphinx sphinx-rtd-theme myst-parser pytest pytest-cov mypy ruff && cd analise/Python && pip install --break-system-packages -e . 2>/dev/null || echo \"Skipping editable install\"'",
  "remoteUser": "vscode",
  "forwardPorts": [8501, 8000, 8888],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit Dashboard",
      "onAutoForward": "openBrowser"
    },
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "openBrowser"
    }
  }
}
