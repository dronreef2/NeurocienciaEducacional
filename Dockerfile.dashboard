# Dashboard Streamlit para o programa
# Build: docker build -f Dockerfile.dashboard -t neurociencia-dashboard .
# Run: docker run -p 8501:8501 neurociencia-dashboard

FROM python:3.11-slim

WORKDIR /app

# Dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copiar arquivos
COPY requirements.txt .
COPY streamlit_app.py .
COPY .streamlit/ .streamlit/
COPY analise/ analise/
COPY 01-projeto-qualitativo-criancas-ia/ 01-projeto-qualitativo-criancas-ia/

# Instalar dependências
RUN pip install --no-cache-dir -r requirements.txt

# Expor porta
EXPOSE 8501

# Variáveis de ambiente
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Comando padrão
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl --fail http://localhost:8501/_stcore/health || exit 1
